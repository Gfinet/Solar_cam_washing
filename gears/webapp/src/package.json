{
  "name": "transcendence",
  "private": true,
  "version": "0.0.1",
  "bin": {
    "transcendence": "./runtime/app.js"
  },
  "scripts": {
    "build": "webpack --mode=production -c ./config/webpack.config.js",
    "build-watch": "webpack --mode=development -c ./config/webpack.config.js --watch",
    "start-watch": "cross-env NODE_ENV=development nodemon -w runtime runtime/app.js",
    "dev": "npm-run-all --parallel build-watch start-watch",
    "start": "node runtime/app.js",
    "format": "prettier --write \"**/*.{md,ts,html,vue,js}\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/passport": "^3.0.2",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.1.0",
    "@heroicons/vue": "1.0.6",
    "@levminer/speakeasy": "^1.4.2",
    "@node-saml/passport-saml": "^5.0.1",
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.3.3",
    "fastify-socket": "^5.1.2",
    "google-auth-library": "^10.1.0",
    "handlebars": "^4.7.8",
    "hashids": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^8.0.4",
    "lottie-web-vue": "^2.0.7",
    "marked": "^15.0.7",
    "nodemailer": "^7.0.4",
    "passport-oauth2": "^1.8.0",
    "pino": "^8.15.1",
    "pino-pretty": "^10.0.0",
    "qrcode": "^1.5.4",
    "random-words": "^2.0.1",
    "sequelize": "^6.37.7",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^5.1.7",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue3-google-login": "^2.0.33",
    "vuex": "^4.1.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
